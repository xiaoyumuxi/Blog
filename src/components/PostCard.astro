---
import type { CollectionEntry } from 'astro:content';
import Art from './Art.astro';
import Icon from './Icon.astro';
import { href, formatDate, readTime } from '../lib/site';

interface Props { post: CollectionEntry<'blog'>; }
const {post} = Astro.props;
const series = post.data.series;
---
<article class="post-card" data-post-card data-tags={JSON.stringify(post.data.tags)}>
  <a class="post-art-link" href={href(`blog/${post.id}/`)} tabindex="-1" aria-hidden="true"><Art variant={post.data.art} /></a>
  <div class="post-card-body">
    <div class="post-meta">
      <span>
        {series
          ? <a class="post-series-link" href={href(`series/${series.slug}/`)}>{series.name}</a>
          : (post.data.tags[0] || '随笔')}
      </span>
      <span>{readTime(post.body)} 分钟阅读</span>
    </div>
    <h3><a href={href(`blog/${post.id}/`)}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <div class="post-card-foot">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.source?.platform && <span class="source-label">{post.data.source.platform}</span>}
      {post.data.sample && <span class="sample-label">示例文章</span>}
      <a class="icon-link" href={href(`blog/${post.id}/`)} aria-label={`阅读：${post.data.title}`}><Icon name="arrow" size={18}/></a>
    </div>
  </div>
</article>
