---
interface Props { variant?: string; hero?: boolean; }
const { variant = 'orbit', hero = false } = Astro.props;
---
<div class:list={['art', `art-${variant}`, { 'art-hero': hero }]} aria-hidden="true">
  <div class="art-grid"></div><div class="art-glow"></div>
  {variant === 'orbit' ? <><div class="orbit-disc"><i></i><i></i><i></i><div class="orbit-core">X<span>✦</span></div></div><span class="star star-a">✦</span><span class="star star-b">+</span><div class="art-label label-a"><span class="tiny-dot"></span> IDEAS IN ORBIT</div><div class="art-label label-b">&lt; / &gt; <span>Build. Write. Share.</span></div></> : variant === 'code' ? <><div class="code-art"><div class="window-dots"><i></i><i></i><i></i><span>hello.mdx</span></div><div class="code-art-lines"><span><b>01</b><em>#</em> Hello, world.</span><span><b>02</b></span><span><b>03</b><em>const</em> ideas = [</span><span><b>04</b>&nbsp; <q>code</q>, <q>create</q></span><span><b>05</b>];<i class="cursor"></i></span></div></div><span class="code-float">&#123; &#125;</span></> : <><div class="file-art file-back"></div><div class="file-art file-front"><span>↓</span><i></i><i></i><small>OPEN & SHARE</small></div><span class="file-pill">PDF</span><span class="file-pill file-pill-two">.zip</span></>}
</div>
