---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import ArticleFilters from '../components/ArticleFilters.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { posts, href, site } from '../lib/site';

const all = await posts();
const recent = all.slice(0, 6);
---
<Base>
  <section class="profile-hero" aria-labelledby="hero-title">
    <div class="profile-hero-copy">
      <div class="profile-kicker">
        <div class="avatar-shell">
          <img src="https://avatars.githubusercontent.com/u/145102356?v=4" alt="" width="56" height="56"/>
        </div>
        <div>
          <strong>计算机专业学生</strong>
          <span>主要学习后端和系统开发</span>
        </div>
      </div>

      <h1 id="hero-title">你好，我是 <span class="gradient-text">xiaoyumuxi。</span></h1>

      <p class="profile-lead">
        我主要使用 Java，也在学习 Rust、系统开发和 AI Agent。
        这里记录一些项目、笔记和学习过程。
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href={href('blog/')}>读文章 <Icon name="right" size={16}/></a>
        <a class="button" href="#projects">看项目 <Icon name="right" size={16}/></a>
      </div>

      <div class="profile-links">
        <span>Java · Rust · AI Agent</span>
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow" size={14}/></a>
      </div>
    </div>

    <aside class="about-note" aria-labelledby="about-note-title">
      <div class="about-note-head">ABOUT ME</div>
      <h2 id="about-note-title">目前在学习和实践</h2>
      <ul>
        <li><span>后端</span><strong>Java · Spring · MySQL</strong></li>
        <li><span>系统</span><strong>Rust · Linux · 网络</strong></li>
        <li><span>AI</span><strong>Agent · Tools · Runtime</strong></li>
      </ul>
    </aside>
  </section>

  <section class="selected-work" id="projects" aria-labelledby="work-title">
    <div class="section-header">
      <div>
        <div class="eyebrow">SELECTED WORK</div>
        <h2 id="work-title">我的项目<span style="color:var(--purple)">.</span></h2>
      </div>
      <a class="section-link" href={site.github} target="_blank" rel="noopener noreferrer">
        全部仓库 <Icon name="arrow" size={17}/>
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index}/>)}
    </div>
  </section>

  <section aria-labelledby="writing-title">
    <div class="section-header">
      <div>
        <div class="eyebrow">WRITING & EXPLORING</div>
        <h2 id="writing-title">最近写下的<span style="color:var(--purple)">.</span></h2>
      </div>
      <a class="section-link" href={href('blog/')}>全部文章 <Icon name="arrow" size={17}/></a>
    </div>
    <ArticleFilters />
    <div class="post-grid">{recent.map(post => <PostCard post={post}/>)}</div>
    <p class="empty-state" data-empty hidden>这个栏目下还没有文章。</p>
  </section>

  <section class="home-lower" aria-label="资源与随记">
    <div class="resource-teaser">
      <div class="small-heading">
        <h2>不止于文字</h2>
        <a class="section-link" href={href('resources/')}>资源架 <Icon name="arrow" size={16}/></a>
      </div>
      <div class="teaser-files">
        <a href={href('downloads/writing-template.md')} download>
          <Icon name="file" size={23}/><span>写作起点<small>MARKDOWN · 模板下载</small></span>
        </a>
        <a href={href('downloads/bluehour-sample.pdf')} download>
          <Icon name="download" size={23}/><span>随手带走<small>PDF · 示例文档</small></span>
        </a>
      </div>
    </div>
    <div class="note-card">
      <div class="eyebrow">随手记</div>
      <p>项目和笔记，慢慢更新。</p>
      <small>有新的内容会放在这里。</small>
    </div>
  </section>
</Base>
