---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { posts, href, site } from '../lib/site';

const all = await posts();
const recent = all.slice(0, 6);
const tags = [...new Set(recent.flatMap(p => p.data.tags))].slice(0, 5);
const focus = [
  ['Backend', 'Java · Spring · MySQL · Redis', '把框架原理与工程落地放在一起。'],
  ['Systems', 'Rust · OS · RPC · Networking', '从运行时、协议到操作系统继续往底层走。'],
  ['Agents', 'Runtime · Tools · Evaluation', '不只做聊天页面，更关注 Agent 的执行与可靠性。'],
];
---
<Base>
  <section class="profile-hero" aria-labelledby="hero-title">
    <div class="profile-hero-copy">
      <div class="profile-kicker"><span></span>{site.handle} · BUILDING IN PUBLIC</div>

      <div class="profile-identity">
        <div class="avatar-shell">
          <img src="https://avatars.githubusercontent.com/u/145102356?v=4" alt="xiaoyumuxi 的 GitHub 头像" width="82" height="82"/>
          <i aria-hidden="true"></i>
        </div>
        <div>
          <div class="profile-focus">JAVA BACKEND · SYSTEMS · AI AGENTS</div>
          <h1 id="hero-title">把系统做扎实，<br/><span class="gradient-text">把 Agent 做到能跑。</span></h1>
        </div>
      </div>

      <p class="profile-lead">
        这里记录我对后端、分布式系统与 Agent Runtime 的实践。
        比起“会用一个框架”，我更想知道它为什么这样工作，以及怎样把它做得更可靠。
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href={site.github} target="_blank" rel="noopener noreferrer">
          GitHub <Icon name="arrow" size={16}/>
        </a>
        <a class="button" href={href('blog/')}>读文章 <Icon name="right" size={16}/></a>
      </div>

      <div class="profile-stack" aria-label="主要技术方向">
        {['Java', 'Rust', 'Go', 'Python', 'Spring', 'Redis', 'Docker', 'Linux'].map(item => <span>{item}</span>)}
      </div>
    </div>

    <div class="profile-console" aria-label="xiaoyumuxi 的技术方向">
      <div class="console-glow console-glow-a"></div>
      <div class="console-glow console-glow-b"></div>

      <div class="console-window">
        <div class="console-bar">
          <span class="console-dots"><i></i><i></i><i></i></span>
          <span>profile://xiaoyumuxi</span>
          <span class="console-live"><i></i> online</span>
        </div>

        <div class="console-body">
          <p><b>role</b><span>Computer Science Student</span></p>
          <p><b>focus</b><span>Java Backend · System Engineering</span></p>
          <p><b>building</b><span>AI Apps · Agent Runtime</span></p>
          <p><b>learning</b><span>Rust · Operating Systems</span></p>
        </div>
      </div>

      <div class="floating-signal signal-rpc">
        <small>RPC</small><strong>Netty → Nacos → Protobuf</strong>
      </div>
      <div class="floating-signal signal-agent">
        <small>AGENT</small><strong>Runtime · Tools · Eval</strong>
      </div>

      <div class="console-orbit" aria-hidden="true">
        <span></span><span></span><span></span><b>X</b>
      </div>
    </div>
  </section>

  <section class="home-signals" aria-label="技术方向">
    {focus.map(([title, stack, text], index) =>
      <article>
        <span class="signal-number">0{index + 1}</span>
        <div>
          <small>{stack}</small>
          <h2>{title}</h2>
          <p>{text}</p>
        </div>
      </article>
    )}
  </section>

  <section class="selected-work" aria-labelledby="work-title">
    <div class="section-header">
      <div>
        <div class="eyebrow">SELECTED WORK</div>
        <h2 id="work-title">正在构建的东西<span style="color:var(--purple)">.</span></h2>
      </div>
      <a class="section-link" href={site.github} target="_blank" rel="noopener noreferrer">
        全部仓库 <Icon name="arrow" size={17}/>
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index}/>)}
    </div>
  </section>

  <section aria-labelledby="writing-title">
    <div class="section-header">
      <div>
        <div class="eyebrow">WRITING & EXPLORING</div>
        <h2 id="writing-title">最近写下的<span style="color:var(--purple)">.</span></h2>
      </div>
      <a class="section-link" href={href('blog/')}>全部文章 <Icon name="arrow" size={17}/></a>
    </div>
    <div class="filters" aria-label="按标签筛选文章">
      <button data-filter="" aria-pressed="true">全部</button>
      {tags.map(tag => <button data-filter={tag} aria-pressed="false">{tag}</button>)}
    </div>
    <div class="post-grid">{recent.map(post => <PostCard post={post}/>)}</div>
    <p class="empty-state" data-empty hidden>这个标签下还没有文章。</p>
  </section>

  <section class="home-lower" aria-label="资源与随记">
    <div class="resource-teaser">
      <div class="small-heading">
        <h2>不止于文字</h2>
        <a class="section-link" href={href('resources/')}>资源架 <Icon name="arrow" size={16}/></a>
      </div>
      <div class="teaser-files">
        <a href={href('downloads/writing-template.md')} download>
          <Icon name="file" size={23}/><span>写作起点<small>MARKDOWN · 模板下载</small></span>
        </a>
        <a href={href('downloads/bluehour-sample.pdf')} download>
          <Icon name="download" size={23}/><span>随手带走<small>PDF · 示例文档</small></span>
        </a>
      </div>
    </div>
    <div class="note-card">
      <div class="eyebrow">CURRENT DIRECTION</div>
      <p>Backend → Systems → Agent Runtime.</p>
      <small>把学习路径变成真正运行过的项目，而不是一串关键词。</small>
    </div>
  </section>
</Base>
