---
import type { SeriesGroup } from '../../lib/series';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { href } from '../../lib/site';
import { seriesGroups } from '../../lib/series';

export async function getStaticPaths() {
  const groups = await seriesGroups();
  return groups.map(group => ({ params: { slug: group.slug }, props: { group } }));
}

interface Props { group: SeriesGroup; }
const { group } = Astro.props;
---
<Base title={group.name} description={group.description}>
  <header class="page-heading series-detail-heading">
    <div class="breadcrumb"><a href={href()}>首页</a><span>/</span><a href={href('series/')}>系列</a><span>/</span><span>{group.name}</span></div>
    <div class="eyebrow">SERIES</div>
    <h1>{group.name}<span class="gradient-text">.</span><span class="inline-count">{group.posts.length} 篇</span></h1>
    <p>{group.description}</p>
  </header>

  <section class="page-content" aria-label={`${group.name}文章列表`}>
    <ol class="series-timeline">
      {group.posts.map((post, index) => (
        <li>
          <span class="series-order">{String(post.data.series?.order ?? index + 1).padStart(2, '0')}</span>
          <PostCard post={post}/>
        </li>
      ))}
    </ol>
  </section>
</Base>
