---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import {posts, href, site, formatDate, readTime} from '../../lib/site';
export async function getStaticPaths(){return (await posts()).map(post=>({params:{id:post.id},props:{post}}));}
interface Props {post: CollectionEntry<'blog'>;}
const {post}=Astro.props;
const {Content,headings}=await render(post);
const toc=headings.filter(h=>h.depth===2||h.depth===3);
---
<Base title={post.data.title} description={post.data.description} article>
  <div class="reading-progress" aria-hidden="true"></div>
  <header class="article-header"><div class="breadcrumb"><a href={href()}>首页</a><span>/</span><a href={href('blog/')}>文章</a><span>/</span><span>{post.data.tags[0]||'随笔'}</span></div><div class="tag-list">{post.data.tags.map(tag=><a class="tag" href={href(`blog/?tag=${encodeURIComponent(tag)}`)}>{tag}</a>)}</div><h1 data-pagefind-meta="title">{post.data.title}</h1><p>{post.data.description}</p><div class="article-meta"><span class="author-mini"><span class="brand-mark">J</span>{site.name}</span><span>·</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>·</span><span>{readTime(post.body)} 分钟阅读</span>{post.data.sample&&<span class="sample-label">站点示例 · 可替换</span>}</div></header>
  <div class="article-cover"><Art variant={post.data.art}/></div>
  <div class="article-layout"><article class="prose" data-pagefind-body data-article><Content/><div class="article-end" data-pagefind-ignore><span>感谢阅读，愿这里有一个对你有用的想法。</span><a href={href('blog/')}>← 返回文章列表</a></div></article><aside class="toc" aria-label="文章目录"><strong>ON THIS PAGE</strong>{toc.map(h=><a class={`depth-${h.depth}`} href={`#${h.slug}`}>{h.text}</a>)}<div class="toc-footer"><a href={href('resources/')}>下载资源 ↗</a><a href={href('rss.xml')}>订阅 RSS ↗</a></div></aside></div>
</Base>
