---
import Base from '../layouts/Base.astro';
import DownloadCard from '../components/DownloadCard.astro';
import { resources } from '../data/resources';
import { href } from '../lib/site';
---
<Base title="资源架"><header class="page-heading"><div class="eyebrow">THE RESOURCE SHELF</div><h1>有用的，带走就好<span class="gradient-text">.</span></h1><p>让分享不止停留在文字。文档、模板、数据与源码，都可以在这里找到自己的位置。</p></header><section class="page-content" aria-label="下载资源"><div class="resource-grid">{resources.map(resource=><DownloadCard {...resource}/>)}</div><div class="resource-notice">这里集中放可以直接下载的文档、模板与其他公开资源。后续有新的附件时，会继续整理到这个资源架。</div></section></Base>
